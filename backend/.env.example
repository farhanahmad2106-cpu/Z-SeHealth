# ================================================================
# Z-SeHealth Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it's in .gitignore.
# ================================================================

# --- Core Infrastructure ---
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/Z-sehealth

# --- Firebase Admin SDK ---
# Option 1: Paste the full JSON string of your firebase-admin-key.json (for production)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
# Option 2: Use the local JSON file (for local dev — see firebase-admin-key.json)

# --- AI Models ---
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA API Keys — rotate through multiple keys when rate limited
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_API_KEY_1=your_nvidia_key_1_here
NVIDIA_API_KEY_2=your_nvidia_key_2_here
NVIDIA_API_KEY_3=your_nvidia_key_3_here
NVIDIA_API_KEY_4=your_nvidia_key_4_here
NVIDIA_API_KEY_5=your_nvidia_key_5_here

# NVIDIA Model names (optional — defaults used if not set)
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct

# ================================================================
# FREEMIUM — Razorpay (Payment Gateway)
# Step-by-step setup guide: see walkthrough.md
# ================================================================

# Your Razorpay API credentials (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Razorpay Webhook secret (from Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Subscription Plan IDs (create these in Razorpay Dashboard > Products > Subscriptions > Plans)
RAZORPAY_PLAN_ID_STARTER=plan_xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_ELITE=plan_xxxxxxxxxxxxxxxx

# ================================================================
# FREEMIUM — Sarvam AI (Z-Elite tier only)
# Get your key from: https://dashboard.sarvam.ai
# ================================================================
SARVAM_API_KEY=your_sarvam_api_key_here
